{
  "name": "@lorre-blocks/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lorre Blocks token engine: theme definitions -> OKLCH scales, Tailwind v4 CSS, DTCG JSON. Pure TS, browser-safe.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check:bindings": "tsx scripts/check-figma-bindings.ts",
    "check:figma": "tsx scripts/sync-figma-tokens.ts --check",
    "sync:figma": "tsx scripts/sync-figma-tokens.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
