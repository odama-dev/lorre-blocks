{
  "name": "lorre-blocks",
  "version": "0.6.0",
  "description": "Add lorre-blocks components to your project by copying their source in.",
  "type": "module",
  "bin": {
    "lorre-blocks": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "components",
    "react",
    "tailwind",
    "shadcn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odama-dev/lorre-blocks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/odama-dev/lorre-blocks#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
