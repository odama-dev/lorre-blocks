{
  "name": "lorre-blocks-mcp",
  "version": "0.0.0",
  "description": "MCP server for the Lorre Blocks registry: search items, read component source, add components and apply themes via the lorre-blocks CLI.",
  "type": "module",
  "bin": {
    "lorre-blocks-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "components",
    "design-tokens",
    "react",
    "tailwind"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odama-dev/lorre-blocks.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/odama-dev/lorre-blocks#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "lorre-blocks": "workspace:^",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
