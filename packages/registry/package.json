{
  "name": "@lorre-blocks/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source of truth for lorre-blocks components + registry build script",
  "scripts": {
    "build": "tsx scripts/build-registry.ts",
